// =============================================================================
// Sri Lanka Travel Marketplace — database schema (Stage 2A)
//
// IMPORTANT: several integrity rules live ONLY in raw SQL migrations and are
// invisible to this file (exclusion constraints, partial unique indexes, CHECK
// constraints). See backend/README.md → "Database constraints not represented
// in schema.prisma". Never run `prisma db push` against a shared database.
//
// Conventions
//   * Table / column / enum names are snake_case via @@map / @map.
//   * All timestamps are timestamptz (UTC). Display timezone is Asia/Colombo.
//   * Money is Decimal(12,2); currency defaults to "LKR".
//   * Primary keys are UUIDs generated by PostgreSQL (gen_random_uuid()) so raw
//     SQL inserts get ids too. updated_at has a DB default for the same reason.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum Role {
  CUSTOMER
  OWNER
  DRIVER
  ADMIN

  @@map("role")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@map("user_status")
}

enum OwnerType {
  INDIVIDUAL
  BUSINESS

  @@map("owner_type")
}

/// Verification lifecycle for owners and drivers.
enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED

  @@map("verification_status")
}

enum DocumentSubject {
  OWNER
  DRIVER
  VEHICLE

  @@map("document_subject")
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("document_status")
}

enum VehicleApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED

  @@map("vehicle_approval_status")
}

enum Transmission {
  MANUAL
  AUTOMATIC

  @@map("transmission")
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
  LPG

  @@map("fuel_type")
}

enum PricingUnit {
  PER_DAY
  PER_KM
  PER_HOUR
  PER_TRIP

  @@map("pricing_unit")
}

enum TripType {
  ONE_WAY
  RETURN
  HOURLY
  MULTI_DAY
  AIRPORT_TRANSFER

  @@map("trip_type")
}

enum TripRequestStatus {
  SUBMITTED
  QUOTED
  REJECTED
  EXPIRED
  CANCELLED
  CONVERTED

  @@map("trip_request_status")
}

enum QuotationStatus {
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  SUPERSEDED
  CANCELLED

  @@map("quotation_status")
}

/// Booking lifecycle only. Payment / refund / settlement statuses are separate
/// lifecycles (Stage 2B) and must never be added here.
enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
  EXPIRED

  @@map("booking_status")
}

/// Trip (operational) lifecycle, separate from BookingStatus.
enum TripStatus {
  ASSIGNED
  ACCEPTED
  ON_THE_WAY
  ARRIVED
  STARTED
  COMPLETED

  @@map("trip_status")
}

enum OccupancyKind {
  BLOCK
  HOLD
  BOOKING

  @@map("occupancy_kind")
}

enum OccupancyStatus {
  ACTIVE
  RELEASED

  @@map("occupancy_status")
}

enum DriverAssignmentStatus {
  ACTIVE
  REPLACED
  CANCELLED

  @@map("driver_assignment_status")
}

// -----------------------------------------------------------------------------
// Identity
// -----------------------------------------------------------------------------

/// Contact details (email, phone) live only here. Visibility to other parties is
/// governed by the contact-privacy rule (see docs/database/state-machines.md).
model User {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String     @unique
  phone           String?
  passwordHash    String     @map("password_hash")
  fullName        String     @map("full_name")
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles           UserRole[]
  customerProfile CustomerProfile?
  ownerProfile    OwnerProfile?
  driverProfile   DriverProfile?
  notifications   Notification[]

  @@index([status])
  @@map("user")
}

model UserRole {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      Role
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
  @@map("user_role")
}

model CustomerProfile {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  tripRequests TripRequest[]
  bookings     Booking[]

  @@map("customer_profile")
}

model OwnerProfile {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String             @unique @map("user_id") @db.Uuid
  ownerType          OwnerType          @map("owner_type")
  businessName       String?            @map("business_name")
  businessRegNumber  String?            @map("business_reg_number")
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  verifiedAt         DateTime?          @map("verified_at") @db.Timestamptz(3)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user           User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  drivers        DriverProfile[]
  vehicles       Vehicle[]
  operatingAreas OwnerOperatingArea[]
  documents      Document[]

  @@index([verificationStatus])
  @@map("owner_profile")
}

/// A driver belongs to exactly one owner. `userId` is optional (drivers may not
/// log in) and UNIQUE, so one human has at most one driver profile — this makes
/// the driver overlap constraint cover the person, not just the profile.
/// An owner-driver is the owner's own driver profile (isOwnerDriver = true,
/// userId = owner's userId — the latter is enforced in the service layer).
model DriverProfile {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId            String             @map("owner_id") @db.Uuid
  userId             String?            @unique @map("user_id") @db.Uuid
  fullName           String             @map("full_name")
  phone              String?
  licenceNumber      String             @unique @map("licence_number")
  licenceExpiresAt   DateTime?          @map("licence_expires_at") @db.Timestamptz(3)
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  isOwnerDriver      Boolean            @default(false) @map("is_owner_driver")
  isActive           Boolean            @default(true) @map("is_active")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner              OwnerProfile       @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  user               User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  vehicleLinks       VehicleDriver[]    @relation("VehicleDriverOwnerMatch")
  vehicleLinksByFlag VehicleDriver[]    @relation("VehicleDriverFlagMatch")
  assignments        DriverAssignment[]
  documents          Document[]

  // Targets for composite foreign keys on vehicle_driver.
  @@unique([id, ownerId])
  @@unique([id, isOwnerDriver])
  @@index([ownerId])
  @@index([verificationStatus])
  @@map("driver_profile")
}

// -----------------------------------------------------------------------------
// Verification
// -----------------------------------------------------------------------------

/// Exactly one of ownerId / driverId / vehicleId is set and it matches
/// subjectType (CHECK constraint in raw SQL). storageKey is a private object
/// key — never a public URL; signed URLs are generated on demand.
model Document {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subjectType      DocumentSubject @map("subject_type")
  ownerId          String?         @map("owner_id") @db.Uuid
  driverId         String?         @map("driver_id") @db.Uuid
  vehicleId        String?         @map("vehicle_id") @db.Uuid
  documentType     String          @map("document_type")
  storageKey       String          @map("storage_key")
  originalFileName String?         @map("original_file_name")
  mimeType         String?         @map("mime_type")
  validUntil       DateTime?       @map("valid_until") @db.Timestamptz(3)
  status           DocumentStatus  @default(PENDING)
  reviewedByUserId String?         @map("reviewed_by_user_id") @db.Uuid
  reviewedAt       DateTime?       @map("reviewed_at") @db.Timestamptz(3)
  rejectionReason  String?         @map("rejection_reason")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner   OwnerProfile?  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  driver  DriverProfile? @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicle Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([driverId])
  @@index([vehicleId])
  @@index([status, subjectType])
  @@map("document")
}

// -----------------------------------------------------------------------------
// Location
// -----------------------------------------------------------------------------

model Area {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  /// true for development sample data inserted by the seed script.
  isSample  Boolean  @default(false) @map("is_sample")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  owners OwnerOperatingArea[]

  @@index([isActive])
  @@map("area")
}

model OwnerOperatingArea {
  ownerId   String   @map("owner_id") @db.Uuid
  areaId    String   @map("area_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner OwnerProfile @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  area  Area         @relation(fields: [areaId], references: [id], onDelete: Restrict)

  @@id([ownerId, areaId])
  @@index([areaId])
  @@map("owner_operating_area")
}

// -----------------------------------------------------------------------------
// Vehicles
// -----------------------------------------------------------------------------

model VehicleCategory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  vehicles Vehicle[]

  @@index([isActive, sortOrder])
  @@map("vehicle_category")
}

/// Publicly bookable ⇔ approvalStatus = APPROVED AND isActive AND linked to at
/// least one APPROVED, active driver (computed in the service layer).
model Vehicle {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId            String                @map("owner_id") @db.Uuid
  categoryId         String                @map("category_id") @db.Uuid
  make               String
  model              String
  year               Int
  registrationNumber String                @unique @map("registration_number")
  seats              Int
  luggageCapacity    Int                   @default(0) @map("luggage_capacity")
  airConditioned     Boolean               @default(true) @map("air_conditioned")
  transmission       Transmission
  fuelType           FuelType              @map("fuel_type")
  features           String[]              @default([])
  description        String?
  approvalStatus     VehicleApprovalStatus @default(PENDING) @map("approval_status")
  approvedAt         DateTime?             @map("approved_at") @db.Timestamptz(3)
  approvedByUserId   String?               @map("approved_by_user_id") @db.Uuid
  rejectionReason    String?               @map("rejection_reason")
  isActive           Boolean               @default(true) @map("is_active")
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner            OwnerProfile       @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  category         VehicleCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images           VehicleImage[]
  drivers          VehicleDriver[]
  indicativePrices IndicativePrice[]
  documents        Document[]
  tripRequests     TripRequest[]
  quotations       Quotation[]
  bookings         Booking[]
  occupancies      VehicleOccupancy[]

  // Target for composite FKs (vehicle_id, owner_id) that guarantee ownership consistency.
  @@unique([id, ownerId])
  @@index([ownerId])
  @@index([categoryId])
  @@index([approvalStatus, isActive, categoryId])
  @@map("vehicle")
}

model VehicleImage {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vehicleId  String   @map("vehicle_id") @db.Uuid
  storageKey String   @map("storage_key")
  sortOrder  Int      @default(0) @map("sort_order")
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, sortOrder])
  @@map("vehicle_image")
}

/// Link between a vehicle and a driver of the SAME owner.
///   * (vehicle_id, owner_id) → vehicle(id, owner_id)          — same owner
///   * (driver_id,  owner_id) → driver_profile(id, owner_id)   — same owner
///   * (driver_id, is_owner_driver) → driver_profile(id, is_owner_driver)
///     keeps the denormalised flag truthful (ON UPDATE CASCADE).
/// Raw SQL adds: a normal driver may be linked to only one vehicle.
model VehicleDriver {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vehicleId     String   @map("vehicle_id") @db.Uuid
  driverId      String   @map("driver_id") @db.Uuid
  ownerId       String   @map("owner_id") @db.Uuid
  isOwnerDriver Boolean  @map("is_owner_driver")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  vehicle    Vehicle       @relation(fields: [vehicleId, ownerId], references: [id, ownerId], onDelete: Cascade)
  driver     DriverProfile @relation("VehicleDriverOwnerMatch", fields: [driverId, ownerId], references: [id, ownerId], onDelete: Cascade)
  driverFlag DriverProfile @relation("VehicleDriverFlagMatch", fields: [driverId, isOwnerDriver], references: [id, isOwnerDriver], onDelete: Cascade, onUpdate: Cascade)

  @@unique([vehicleId, driverId])
  @@index([driverId])
  @@index([vehicleId, ownerId])
  @@index([driverId, ownerId])
  @@index([driverId, isOwnerDriver])
  @@map("vehicle_driver")
}

model IndicativePrice {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vehicleId   String      @map("vehicle_id") @db.Uuid
  pricingUnit PricingUnit @map("pricing_unit")
  amount      Decimal     @db.Decimal(12, 2)
  currency    String      @default("LKR") @db.Char(3)
  notes       String?
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, pricingUnit])
  @@map("indicative_price")
}

// -----------------------------------------------------------------------------
// Booking flow: TripRequest → Quotation → Booking
// -----------------------------------------------------------------------------

/// Owner-visible fields at request time: customer's name (via user), trip
/// details and passengerCount. Customer phone/email are NOT exposed until the
/// booking is CONFIRMED (service-layer rule 14).
model TripRequest {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId          String            @map("customer_id") @db.Uuid
  vehicleId           String            @map("vehicle_id") @db.Uuid
  /// Denormalised for the owner inbox; kept consistent by FK (vehicle_id, owner_id).
  ownerId             String            @map("owner_id") @db.Uuid
  tripType            TripType          @map("trip_type")
  pickupAddress       String            @map("pickup_address")
  pickupLat           Decimal?          @map("pickup_lat") @db.Decimal(9, 6)
  pickupLng           Decimal?          @map("pickup_lng") @db.Decimal(9, 6)
  destinationAddress  String?           @map("destination_address")
  destinationLat      Decimal?          @map("destination_lat") @db.Decimal(9, 6)
  destinationLng      Decimal?          @map("destination_lng") @db.Decimal(9, 6)
  requestedStartAt    DateTime          @map("requested_start_at") @db.Timestamptz(3)
  requestedReturnAt   DateTime?         @map("requested_return_at") @db.Timestamptz(3)
  /// For HOURLY trips.
  requestedHours      Int?              @map("requested_hours")
  passengerCount      Int               @map("passenger_count")
  luggageNotes        String?           @map("luggage_notes")
  specialRequirements String?           @map("special_requirements")
  flightNumber        String?           @map("flight_number")
  flightArrivalAt     DateTime?         @map("flight_arrival_at") @db.Timestamptz(3)
  status              TripRequestStatus @default(SUBMITTED)
  rejectionReason     String?           @map("rejection_reason")
  respondedAt         DateTime?         @map("responded_at") @db.Timestamptz(3)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer      CustomerProfile            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle       Vehicle                    @relation(fields: [vehicleId, ownerId], references: [id, ownerId], onDelete: Restrict)
  stops         TripStop[]
  quotation     Quotation?
  statusHistory TripRequestStatusHistory[]

  // Target for quotation (trip_request_id, vehicle_id) composite FK.
  @@unique([id, vehicleId])
  @@index([customerId, createdAt])
  @@index([ownerId, status, createdAt])
  @@index([vehicleId, ownerId])
  @@index([status])
  @@map("trip_request")
}

model TripStop {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripRequestId String   @map("trip_request_id") @db.Uuid
  sequence      Int
  address       String
  lat           Decimal? @db.Decimal(9, 6)
  lng           Decimal? @db.Decimal(9, 6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tripRequest TripRequest @relation(fields: [tripRequestId], references: [id], onDelete: Cascade)

  @@unique([tripRequestId, sequence])
  @@map("trip_stop")
}

/// One quotation per trip request (no revisions). startsAt/endsAt is the window
/// that blocks the vehicle if accepted. DB CHECKs: ends_at > starts_at,
/// expires_at <= starts_at.
model Quotation {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripRequestId String          @unique @map("trip_request_id") @db.Uuid
  /// Denormalised for overlap/supersede queries; FK (trip_request_id, vehicle_id).
  vehicleId     String          @map("vehicle_id") @db.Uuid
  startsAt      DateTime        @map("starts_at") @db.Timestamptz(3)
  endsAt        DateTime        @map("ends_at") @db.Timestamptz(3)
  baseAmount    Decimal         @map("base_amount") @db.Decimal(12, 2)
  totalAmount   Decimal         @map("total_amount") @db.Decimal(12, 2)
  currency      String          @default("LKR") @db.Char(3)
  notes         String?
  expiresAt     DateTime        @map("expires_at") @db.Timestamptz(3)
  status        QuotationStatus @default(SENT)
  sentAt        DateTime        @default(now()) @map("sent_at") @db.Timestamptz(3)
  respondedAt   DateTime?       @map("responded_at") @db.Timestamptz(3)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tripRequest   TripRequest              @relation(fields: [tripRequestId, vehicleId], references: [id, vehicleId], onDelete: Restrict)
  vehicle       Vehicle                  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  charges       QuotationCharge[]
  booking       Booking?
  statusHistory QuotationStatusHistory[]

  @@unique([tripRequestId, vehicleId])
  @@index([vehicleId, status, startsAt])
  @@index([status, expiresAt])
  @@index([expiresAt])
  @@map("quotation")
}

model QuotationCharge {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quotationId String   @map("quotation_id") @db.Uuid
  label       String
  amount      Decimal  @db.Decimal(12, 2)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_charge")
}

/// Created only when a quotation is accepted (status PENDING_PAYMENT, backed by
/// a HOLD occupancy). `status` is the booking lifecycle; `tripStatus` is the
/// separate operational lifecycle (null until a driver is assigned).
/// Payment/refund/settlement statuses belong to Stage 2B models.
model Booking {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quotationId String        @unique @map("quotation_id") @db.Uuid
  customerId  String        @map("customer_id") @db.Uuid
  vehicleId   String        @map("vehicle_id") @db.Uuid
  ownerId     String        @map("owner_id") @db.Uuid
  startsAt    DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime      @map("ends_at") @db.Timestamptz(3)
  totalAmount Decimal       @map("total_amount") @db.Decimal(12, 2)
  currency    String        @default("LKR") @db.Char(3)
  status      BookingStatus @default(PENDING_PAYMENT)
  tripStatus  TripStatus?   @map("trip_status")
  confirmedAt DateTime?     @map("confirmed_at") @db.Timestamptz(3)
  cancelledAt DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  expiredAt   DateTime?     @map("expired_at") @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  quotation     Quotation              @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  customer      CustomerProfile        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle       Vehicle                @relation(fields: [vehicleId, ownerId], references: [id, ownerId], onDelete: Restrict)
  occupancies   VehicleOccupancy[]
  assignments   DriverAssignment[]
  tripEvents    TripEvent[]
  statusHistory BookingStatusHistory[]

  @@index([customerId, startsAt])
  @@index([ownerId, status, startsAt])
  @@index([vehicleId, ownerId])
  @@index([vehicleId, startsAt])
  @@index([status])
  @@map("booking")
}

// -----------------------------------------------------------------------------
// Availability
// -----------------------------------------------------------------------------

/// Single source of truth for vehicle availability. One row per owner BLOCK,
/// payment HOLD or confirmed BOOKING. The raw-SQL exclusion constraint forbids
/// two ACTIVE rows of the same vehicle with overlapping [starts_at, blocked_until).
///   blocked_until = ends_at + trip buffer (HOLD/BOOKING) or ends_at (BLOCK)
///   expires_at    = only for HOLD (payment deadline)
model VehicleOccupancy {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vehicleId       String          @map("vehicle_id") @db.Uuid
  kind            OccupancyKind
  status          OccupancyStatus @default(ACTIVE)
  startsAt        DateTime        @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime        @map("ends_at") @db.Timestamptz(3)
  blockedUntil    DateTime        @map("blocked_until") @db.Timestamptz(3)
  expiresAt       DateTime?       @map("expires_at") @db.Timestamptz(3)
  bookingId       String?         @map("booking_id") @db.Uuid
  reason          String?
  createdByUserId String?         @map("created_by_user_id") @db.Uuid
  releasedAt      DateTime?       @map("released_at") @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  vehicle Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([vehicleId, status, startsAt])
  @@index([bookingId])
  @@index([kind, status, expiresAt])
  @@map("vehicle_occupancy")
}

/// Raw SQL adds: no two ACTIVE assignments of the same driver may overlap, and
/// at most one ACTIVE assignment per booking.
model DriverAssignment {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId        String                 @map("booking_id") @db.Uuid
  driverId         String                 @map("driver_id") @db.Uuid
  startsAt         DateTime               @map("starts_at") @db.Timestamptz(3)
  endsAt           DateTime               @map("ends_at") @db.Timestamptz(3)
  status           DriverAssignmentStatus @default(ACTIVE)
  assignedByUserId String                 @map("assigned_by_user_id") @db.Uuid
  endedAt          DateTime?              @map("ended_at") @db.Timestamptz(3)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  driver  DriverProfile @relation(fields: [driverId], references: [id], onDelete: Restrict)

  @@index([bookingId, status])
  @@index([driverId, status, startsAt])
  @@map("driver_assignment")
}

// -----------------------------------------------------------------------------
// Trips
// -----------------------------------------------------------------------------

/// Trip status history (rule 20) — one row per transition of Booking.tripStatus.
model TripEvent {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId   String      @map("booking_id") @db.Uuid
  fromStatus  TripStatus? @map("from_status")
  toStatus    TripStatus  @map("to_status")
  actorUserId String?     @map("actor_user_id") @db.Uuid
  note        String?
  occurredAt  DateTime    @default(now()) @map("occurred_at") @db.Timestamptz(3)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, occurredAt])
  @@map("trip_event")
}

// -----------------------------------------------------------------------------
// Status history (rule 20) — one table per entity, so each row has a real FK
// and a typed enum column. actorUserId is null for system transitions.
// -----------------------------------------------------------------------------

model TripRequestStatusHistory {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripRequestId String             @map("trip_request_id") @db.Uuid
  fromStatus    TripRequestStatus? @map("from_status")
  toStatus      TripRequestStatus  @map("to_status")
  actorUserId   String?            @map("actor_user_id") @db.Uuid
  reason        String?
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tripRequest TripRequest @relation(fields: [tripRequestId], references: [id], onDelete: Cascade)

  @@index([tripRequestId, createdAt])
  @@map("trip_request_status_history")
}

model QuotationStatusHistory {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quotationId String           @map("quotation_id") @db.Uuid
  fromStatus  QuotationStatus? @map("from_status")
  toStatus    QuotationStatus  @map("to_status")
  actorUserId String?          @map("actor_user_id") @db.Uuid
  reason      String?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId, createdAt])
  @@map("quotation_status_history")
}

model BookingStatusHistory {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId   String         @map("booking_id") @db.Uuid
  fromStatus  BookingStatus? @map("from_status")
  toStatus    BookingStatus  @map("to_status")
  actorUserId String?        @map("actor_user_id") @db.Uuid
  reason      String?
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("booking_status_history")
}

// -----------------------------------------------------------------------------
// Platform
// -----------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_log")
}

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  title     String
  body      String
  data      Json?
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notification")
}

/// Admin-configurable settings. Seeded keys: commissionPercent,
/// quotationExpiryMinHours, quotationExpiryMaxHours, holdDurationMinutes,
/// tripBufferMinutes.
model PlatformSetting {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("platform_setting")
}
