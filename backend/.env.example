NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://travel_marketplace:travel_marketplace_dev@localhost:5432/travel_marketplace
FRONTEND_URL=http://localhost:5173

# Separate database used by the integration tests (created automatically,
# wiped and migrated on every test run). Must NOT point at the dev database.
DATABASE_URL_TEST=postgresql://travel_marketplace:travel_marketplace_dev@localhost:5432/travel_marketplace_test

# Run background jobs (release expired payment holds every minute).
ENABLE_SCHEDULER=false

# Authentication and JWT Configuration
# Required in production: minimum 32 characters
JWT_SECRET=dev-jwt-secret-at-least-32-chars-long-for-testing-auroze
JWT_ISSUER=travel-marketplace-api
JWT_AUDIENCE=travel-marketplace-app
JWT_ACCESS_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=15
PASSWORD_RESET_URL=http://localhost:5173/reset-password

# Email / SMTP Configuration (optional in dev/test; falls back to in-memory/stream transport)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@travelmarketplace.lk
SMTP_SECURE=false

# Seed script only (npm run db:seed). Never commit real values.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Platform Admin
# Optional: password for the sample accounts; unset = sample accounts cannot log in.
SEED_SAMPLE_PASSWORD=

# Proxy trust configuration (false in direct dev; 1, true, hop count, or CIDR when behind reverse proxy/load balancer)
TRUST_PROXY=false
